{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "alf-realtime",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-13",
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true
  },
  "vars": {
    "ALF_API_BASE": "https://alf-api-rhlp.onrender.com",
    "ALLOWED_ORIGINS": "https://alf-app.netlify.app,https://alf-501.netlify.app,http://localhost:5500,http://127.0.0.1:5500,http://localhost:8000"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ACTIVITY_ROOM",
        "class_name": "ActivityRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ActivityRoom"]
    }
  ]
}
