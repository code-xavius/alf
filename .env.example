# Copy to .env and adjust. The backend reads these variables.
# Local development defaults to SQLite and bypassed authentication.

DATABASE_URL=sqlite+aiosqlite:///./alf.db

# Set to false in production. DEV_MODE=true bypasses authentication.
DEV_MODE=true
DEV_USER_ID=dev-user

# Supabase Auth (required when DEV_MODE=false).
# The backend verifies access tokens with SUPABASE_JWT_SECRET, or with JWKS
# derived from SUPABASE_URL when no secret is set.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=

# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:8000

# Optional: serve the frontend from the backend (single-container deployment).
# FRONTEND_DIR=../frontend

ACTIVITY_CODE_LENGTH=6
